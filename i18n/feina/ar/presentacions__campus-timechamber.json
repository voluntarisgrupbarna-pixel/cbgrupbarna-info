   "id": "s069",
   "ar": "تكامل كامل. ختام النسخة."
  },
  {
   "de": 27060,
   "a": 27084,
   "tipus": "text",
   "ca": "Per què amb Time Chamber",
   "id": "s070",
   "ar": "لماذا مع Time Chamber"
  },
  {
