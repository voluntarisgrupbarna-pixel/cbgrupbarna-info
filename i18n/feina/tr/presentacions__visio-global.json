  },
  {
   "de": 22604,
   "a": 22649,
   "tipus": "text",
   "ca": "Un club de barri, seixanta-un anys d'història",
   "id": "s038",
   "tr": ""
  },
  {
   "de": 22666,
   "a": 22822,
   "tipus": "text",
   "ca": "Fundat el 1965 al Poblenou i el Clot, Districte de Sant Martí de Barcelona. Itinerari complet\n        des de pre-mini fins a sènior, sense interrupcions, en",
   "id": "s039",
   "tr": ""
  },
  {
   "de": 22831,
   "a": 22839,
   "tipus": "text",
   "ca": "2 barris",
   "id": "s040",
   "tr": ""
  },
  {
   "de": 22849,
   "a": 22863,
   "tipus": "text",
   "ca": "i amb equips a",
   "id": "s041",
   "tr": ""
  },
  {
   "de": 22880,
   "a": 22889,
   "tipus": "text",
   "ca": "6 escoles",
   "id": "s042",
   "tr": ""
  },
  {
   "de": 22899,
   "a": 22913,
   "tipus": "text",
   "ca": "del territori.",
   "id": "s043",
   "tr": ""
  },
  {
   "de": 22929,
   "a": 23150,
   "tipus": "text",
   "ca": "El sènior femení competeix a Supercopa Femenina i Copa Catalunya, i el supera competitivament\n        el masculí — inversió i resultats van de la mà. Tot això sense pavelló propi ni subvenció\n        municipal específica.",
   "id": "s044",
   "tr": ""
  },
  {
   "de": 23174,
   "a": 23204,
   "tipus": "text",
   "ca": "Únic club de bàsquet finalista",
   "id": "s045",
   "tr": ""
  },
  {
   "de": 23214,
   "a": 23337,
   "tipus": "text",
   "ca": "del 18è Premi Dona i Esport de l'Ajuntament de\n        Barcelona, i homologat amb protocol de protecció del menor (LOPIVI).",
   "id": "s046",
   "tr": ""
  },
  {
   "de": 23407,
   "a": 23417,
   "tipus": "text",
   "ca": "Els Màgics",
   "id": "s047",
   "tr": ""
  },
  {
   "de": 23427,
   "a": 23555,
   "tipus": "text",
   "ca": "— equip inclusiu de bàsquet adaptat per a joves amb diversitat\n      funcional: integració social real, dins i fora de la pista.",
   "id": "s048",
   "tr": ""
  },
  {
   "de": 23564,
   "a": 23573,
   "tipus": "text",
   "ca": "3×3 Barna",
   "id": "s049",
   "tr": ""
  },
  {
   "de": 23583,
   "a": 23591,
   "tipus": "text",
   "ca": "— més de",
   "id": "s050",
   "tr": ""
  },
  {
