  {
   "de": 21311,
   "a": 21468,
   "tipus": "text",
   "ca": "No tenim pressupost de publicitat: et tenim a tu. Quan una família busca un club de bàsquet a Barcelona, Google li ensenya primer els clubs més ben valorats.",
   "id": "s029",
   "en": ""
  },
  {
   "de": 21472,
   "a": 21507,
   "tipus": "text",
   "ca": "Dues línies teves ens fan visibles.",
   "id": "s030",
   "en": ""
  },
  {
   "de": 21630,
   "a": 21653,
   "tipus": "text",
   "ca": "Deixar la meva ressenya",
   "id": "s031",
   "en": ""
  },
  {
   "de": 21711,
   "a": 21809,
   "tipus": "text",
   "ca": "Si no tens la sessió iniciada, Google et demanarà entrar amb el teu compte i tornaràs aquí mateix.",
   "id": "s032",
   "en": ""
  },
  {
   "de": 21813,
