# ── Redireccions de cbgrupbarna.com cap a cbgrupbarna.info ──────────────
#
# La web nova és cbgrupbarna.info. Aquest fitxer hi envia tot el que encara
# apunta a la vella, perquè els deu anys d'antiguitat i d'enllaços d'aquest
# domini comptin per a la nova en comptes de competir-hi.
#
# Cada pàgina va a l'equivalent que tracta el mateix tema, i cada notícia a
# la secció que li correspon. Enviar-ho tot a la portada seria més curt,
# però Google ho llegeix com un error disfressat i no traspassa gairebé
# res: per això hi ha 325 notícies classificades una a una.
#
# L'ORDRE IMPORTA: totes les regles porten [L] i guanya la primera que
# encaixa. Una crònica va a /partits/ encara que parli d'un equip femení;
# a /femeni/ només hi va el que tracta de la secció en si.
#
# IMPORTANT: no donis de baixa ni el domini ni l'allotjament. Un 301 només
# traspassa autoritat mentre segueix responent.

RewriteEngine On

# Deixa passar la renovació del certificat.
RewriteRule ^\.well-known/ - [L]

# ── Les pàgines ─────────────────────────────────────────────────────────
RewriteRule ^club/historia-del-cb-grup-barna/?$        https://cbgrupbarna.info/historia/ [R=301,L]
RewriteRule ^club/pistes-de-joc/?$                     https://cbgrupbarna.info/instal-lacions/ [R=301,L]
RewriteRule ^escola/?$                                 https://cbgrupbarna.info/escoleta/ [R=301,L]
RewriteRule ^activitats-i-campus-2/?$                  https://cbgrupbarna.info/campus/ [R=301,L]
RewriteRule ^equips-temporada-2025-26/?$               https://cbgrupbarna.info/partits/equips/ [R=301,L]
RewriteRule ^equips-(2019-20|2022-23|2023-24)/?$       https://cbgrupbarna.info/historia/ [R=301,L]
RewriteRule ^documents/?$                              https://cbgrupbarna.info/documents/ [R=301,L]
RewriteRule ^patrocin(is|adors)/?$                     https://cbgrupbarna.info/patrocinadors/ [R=301,L]
RewriteRule ^noticies/?$                               https://cbgrupbarna.info/premsa/ [R=301,L]
RewriteRule ^contacte/?$                               https://cbgrupbarna.info/club/ [R=301,L]
RewriteRule ^condicions-dus/?$                         https://cbgrupbarna.info/avis-legal/ [R=301,L]
RewriteRule ^politica-de-privacitat/?$                 https://cbgrupbarna.info/politica-de-privacitat/ [R=301,L]
RewriteRule ^(tienda|mi-cuenta|pagina-ejemplo)/?$      https://cbgrupbarna.info/ [R=301,L]

