   "ar": "في موسم 2023·24 لم يكن إنستغرام يوفّر بعد بيانات المشاهدات للصور والمعارض الدوّارة، ولذلك لا يمكن مقارنة ذلك الموسم إلا بالإعجابات والحجم. وإلى جانب الخلاصة، في موسم 2025·26 هناك"
  },
  {
   "de": 43928,
   "a": 43943,
   "tipus": "text",
   "ca": "1.634 històries",
   "id": "s087",
   "ar": "1,634 قصة"
  },
  {
   "de": 43952,
   "a": 44011,
   "tipus": "text",
   "ca": ", amb 1,63M de visualitzacions i 1,21M de comptes assolits.",
   "id": "s088",
   "ar": "بـ 1.63 مليون مشاهدة و1.21 مليون حساب تم الوصول إليه."
  },
  {
   "de": 44096,
   "a": 44132,
   "tipus": "text",
   "ca": "Seguidors al final de cada temporada",
