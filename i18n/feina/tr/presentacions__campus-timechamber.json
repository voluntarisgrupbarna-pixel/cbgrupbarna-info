   "tipus": "text",
   "ca": "Places per setmana",
   "id": "s037",
   "tr": "Haftalık kontenjan"
  },
  {
   "de": 25327,
   "a": 25351,
   "tipus": "text",
   "ca": "Any de fundació del club",
   "id": "s038",
   "tr": "Kulübün kuruluş yılı"
  },
  {
   "de": 25400,
   "a": 25420,
   "tipus": "text",
   "ca": "Seu: La Nau del Clot",
   "id": "s039",
   "tr": "Mekân: La Nau del Clot"
  },
  {
   "de": 25547,
   "a": 25625,
   "tipus": "atribut",
   "context": "descripció de la imatge",
   "ca": "Sessió de vídeo amb l'entrenador durant el campus de bàsquet del CB Grup Barna",
   "id": "s040",
   "tr": "CB Grup Barna basketbol kampında antrenörle video seansı"
  },
  {
   "de": 25728,
   "a": 25753,
   "tipus": "text",
   "ca": "· No és lleure amb pilota",
   "id": "s041",
   "tr": "· Eğlence amaçlı top oyunu değil"
  },
  {
   "de": 25770,
   "a": 25795,
   "tipus": "text",
   "ca": "Tecnificació, no un casal",
   "id": "s042",
   "tr": "Teknik gelişim, çocuk bakımı değil"
  },
  {
   "de": 25812,
   "a": 25825,
   "tipus": "text",
   "ca": "El campus del",
   "id": "s043",
   "tr": "Okul tatillerinde kulübün yoğun antrenman programı:"
  },
  {
   "de": 25834,
   "a": 25847,
   "tipus": "text",
   "ca": "CB Grup Barna",
   "id": "s044",
   "tr": "CB Grup Barna"
  },
  {
   "de": 25857,
   "a": 25963,
   "tipus": "text",
   "ca": "és el programa d'entrenament intensiu del club durant\n        les vacances escolars. Cada setmana treballa",
   "id": "s045",
   "tr": "kampı.\n        Her hafta"
  },
  {
   "de": 25972,
   "a": 25998,
   "tipus": "text",
   "ca": "un aspecte concret del joc",
   "id": "s046",
   "tr": "oyunun belirli bir yönüne odaklanılır"
  },
  {
   "de": 26007,
   "a": 26109,
   "tipus": "text",
   "ca": ", amb grups\n        fets per edat i nivell perquè ningú entreni per sobre ni per sota del que li toca.",
   "id": "s047",
   "tr": ", gruplar ise yaşa ve seviyeye göre oluşturulur; böylece kimse seviyesinin üstünde\n        ya da altında antrenman yapmaz."
  },
  {
   "de": 26125,
   "a": 26238,
   "tipus": "text",
   "ca": "És obert a jugadors i jugadores de qualsevol club de Barcelona i de la província, no només als del\n        Barna.",
   "id": "s048",
   "tr": "Barcelona'daki ve ilin her kulübünden oyunculara açıktır, yalnızca Barna'dakilere\n        değil."
  },
  {
   "de": 26389,
   "a": 26397,
   "tipus": "text",
   "ca": "Programa",
   "id": "s049",
   "tr": "Program"
  },
  {
   "de": 26406,
   "a": 26433,
   "tipus": "text",
   "ca": "6 setmanes · 6 experiències",
   "id": "s050",
   "tr": "6 hafta · 6 deneyim"
  },
  {
   "de": 26527,
   "a": 26594,
   "tipus": "text",
   "ca": "Cada setmana té identitat\n    pròpia. Es pot venir a una o a totes.",
   "id": "s051",
   "tr": "Her haftanın kendine özgü\n    bir kimliği var. Bir haftaya da hepsine de katılabilirsiniz."
  },
  {
   "de": 26662,
   "a": 26672,
   "tipus": "text",
   "ca": "23–27 juny",
   "id": "s052",
   "tr": "23–27 Haziran"
  },
  {
   "de": 26683,
   "a": 26692,
   "tipus": "text",
   "ca": "Flow Camp",
   "id": "s053",
   "tr": "Flow Camp"
  },
  {
   "de": 26700,
   "a": 26736,
   "tipus": "text",
   "ca": "Fluïdesa ofensiva i joc en moviment.",
   "id": "s054",
   "tr": "Hücumda akıcılık ve hareketli oyun."
  },
  {
   "de": 26786,
   "a": 26799,
   "tipus": "text",
   "ca": "30 juny–4 jul",
   "id": "s055",
   "tr": "30 Haziran–4 Temmuz"
  },
  {
   "de": 26810,
   "a": 26819,
   "tipus": "text",
   "ca": "TC Basics",
   "id": "s056",
   "tr": "TC Basics"
  },
  {
   "de": 26827,
   "a": 26864,
   "tipus": "text",
   "ca": "Fonaments sòlids per a un joc d'elit.",
   "id": "s057",
   "tr": "Üst düzey oyun için sağlam temeller."
  },
  {
   "de": 26914,
   "a": 26922,
   "tipus": "text",
   "ca": "7–11 jul",
   "id": "s058",
   "tr": "7–11 Temmuz"
  },
  {
   "de": 26933,
   "a": 26949,
   "tipus": "text",
   "ca": "Shooting Academy",
   "id": "s059",
   "tr": "Shooting Academy"
  },
  {
   "de": 26957,
   "a": 26992,
   "tipus": "text",
   "ca": "Mecànica, ritme i confiança de tir.",
   "id": "s060",
   "tr": "Atış mekaniği, ritim ve güven."
  },
  {
   "de": 27042,
   "a": 27051,
   "tipus": "text",
   "ca": "14–18 jul",
   "id": "s061",
   "tr": "14–18 Temmuz"
  },
  {
   "de": 27062,
   "a": 27083,
   "tipus": "text",
   "ca": "One &amp; One Mastery",
   "id": "s062",
   "tr": "One &amp; One Mastery"
  },
  {
   "de": 27091,
   "a": 27142,
   "tipus": "text",
   "ca": "Domina l'1 contra 1: fintes i creativitat ofensiva.",
   "id": "s063",
   "tr": "Bire bir oyunda ustalaşın: kandırma hareketleri ve hücum yaratıcılığı."
  },
  {
   "de": 27192,
   "a": 27201,
   "tipus": "text",
   "ca": "21–25 jul",
   "id": "s064",
   "tr": "21–25 Temmuz"
  },
  {
   "de": 27212,
   "a": 27228,
   "tipus": "text",
   "ca": "Ballhandling Lab",
   "id": "s065",
   "tr": "Ballhandling Lab"
  },
  {
   "de": 27236,
   "a": 27270,
   "tipus": "text",
   "ca": "Control de pilota al màxim nivell.",
   "id": "s066",
   "tr": "En üst düzeyde top kontrolü."
  },
  {
   "de": 27320,
   "a": 27332,
   "tipus": "text",
   "ca": "28 jul–1 ago",
   "id": "s067",
   "tr": "28 Temmuz–1 Ağustos"
  },
  {
   "de": 27343,
   "a": 27364,
   "tipus": "text",
   "ca": "Skills Lab Experience",
   "id": "s068",
   "tr": "Skills Lab Experience"
  },
  {
   "de": 27372,
   "a": 27412,
   "tipus": "text",
   "ca": "Integració total. El broche de l'edició.",
   "id": "s069",
   "tr": "Tam entegrasyon. Sezonun finali."
  },
  {
   "de": 27562,
   "a": 27586,
   "tipus": "text",
   "ca": "Per què amb Time Chamber",
   "id": "s070",
   "tr": "Neden Time Chamber ile"
  },
  {
   "de": 27595,
   "a": 27628,
   "tipus": "text",
   "ca": "Metodologia de treball individual",
   "id": "s071",
   "tr": "Bireysel çalışma metodolojisi"
  },
  {
   "de": 27746,
   "a": 27803,
   "tipus": "atribut",
   "context": "descripció de la imatge",
   "ca": "Entrenador del campus explicant un exercici amb la pilota",
   "id": "s072",
   "tr": "Kamp antrenörü bir alıştırmayı top ile anlatıyor"
  },
  {
   "de": 27906,
   "a": 27937,
   "tipus": "text",
   "ca": "· La combinació que el defineix",
   "id": "s073",
   "tr": "· Onu tanımlayan birleşim"
  },
  {
   "de": 27954,
   "a": 27991,
   "tipus": "text",
   "ca": "Volum de repeticions, esperit de club",
   "id": "s074",
   "tr": "Çok tekrar, kulüp ruhu"
  },
  {
   "de": 28008,
   "a": 28038,
   "tipus": "text",
   "ca": "El club treballa el campus amb",
   "id": "s075",
   "tr": "Kulüp, kampı"
  },
  {
   "de": 28047,
   "a": 28059,
   "tipus": "text",
   "ca": "Time Chamber",
   "id": "s076",
   "tr": "Time Chamber"
  },
  {
   "de": 28068,
   "a": 28204,
   "tipus": "text",
   "ca": ", que aporta la metodologia de treball\n        individual: sessions curtes, molt repetitives, dissenyades per a un únic aspecte del joc.",
   "id": "s077",
   "tr": "ile birlikte yürütür. Bireysel çalışma metodolojisini Time Chamber getirir: kısa,\n        çok tekrarlı, oyunun yalnızca tek bir yönü için tasarlanmış seanslar."
  },
  {
   "de": 28220,
   "a": 28252,
   "tipus": "text",
   "ca": "El Barna hi posa l'altra meitat:",
   "id": "s078",
   "tr": "Barna ise diğer yarıyı katar:"
  },
  {
   "de": 28261,
   "a": 28295,
   "tipus": "text",
   "ca": "seixanta-un anys d'ambient d'equip",
   "id": "s079",
   "tr": "altmış bir yıllık takım ruhu"
  },
  {
   "de": 28305,
   "a": 28415,
   "tipus": "text",
   "ca": "de club de barri,\n        grups per edat i nivell, i entrenadors que coneixen cada jugador i jugadora pel nom.",
   "id": "s080",
   "tr": "ile mahalle kulübü havası,\n        yaşa ve seviyeye göre gruplar ve her oyuncuyu adıyla tanıyan antrenörler."
  },
  {
   "de": 28478,
   "a": 28544,
   "tipus": "text",
   "ca": "Sessions dedicades a un sol aspecte del joc, no un totum revolutum",
   "id": "s081",
   "tr": "Her seans oyunun yalnızca tek bir yönüne ayrılmıştır, karmakarışık bir içerik yok"
  },
  {
   "de": 28560,
   "a": 28643,
   "tipus": "text",
   "ca": "Grups per edat i nivell: qui comença no entrena amb qui ja competeix des de fa anys",
   "id": "s082",
   "tr": "Yaşa ve seviyeye göre gruplar: yeni başlayan, yıllardır müsabaka oynayanla antrenman yapmaz"
  },
  {
   "de": 28659,
   "a": 28729,
   "tipus": "text",
   "ca": "Places per a jugadors del Barna i per a jugadors de fora, cada setmana",
   "id": "s083",
   "tr": "Her hafta hem Barna'dan hem dışarıdan oyuncular için kontenjan var"
  },
  {
   "de": 28860,
   "a": 28866,
   "tipus": "text",
   "ca": "La seu",
   "id": "s084",
   "tr": "Mekân"
  },
  {
   "de": 28875,
   "a": 28902,
   "tipus": "text",
   "ca": "La Nau del Clot · Barcelona",
   "id": "s085",
   "tr": "La Nau del Clot · Barcelona"
  },
