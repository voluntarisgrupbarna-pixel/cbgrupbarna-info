   "a": 27126,
   "tipus": "text",
   "ca": "Metodologia de treball individual",
   "id": "s071",
   "ar": "منهجية العمل الفردي"
  },
  {
   "de": 27244,
   "a": 27301,
   "tipus": "atribut",
   "context": "descripció de la imatge",
   "ca": "Entrenador del campus explicant un exercici amb la pilota",
   "id": "s072",
   "ar": "مدرّب المعسكر يشرح تمرينًا بالكرة"
  },
  {
   "de": 27404,
   "a": 27435,
   "tipus": "text",
   "ca": "· La combinació que el defineix",
   "id": "s073",
   "ar": "· المزيج الذي يميّزه"
  },
  {
   "de": 27452,
   "a": 27489,
   "tipus": "text",
   "ca": "Volum de repeticions, esperit de club",
   "id": "s074",
   "ar": "كثافة التكرار وروح النادي"
  },
  {
   "de": 27506,
   "a": 27536,
   "tipus": "text",
   "ca": "El club treballa el campus amb",
   "id": "s075",
   "ar": "يُنظّم النادي المعسكر مع"
  },
  {
   "de": 27545,
   "a": 27557,
   "tipus": "text",
   "ca": "Time Chamber",
   "id": "s076",
   "ar": "Time Chamber"
  },
  {
   "de": 27566,
   "a": 27702,
   "tipus": "text",
   "ca": ", que aporta la metodologia de treball\n        individual: sessions curtes, molt repetitives, dissenyades per a un únic aspecte del joc.",
   "id": "s077",
   "ar": "، التي تقدّم منهجية العمل الفردي: جلسات قصيرة وشديدة التكرار مصمَّمة لجانب واحد من اللعبة."
  },
  {
   "de": 27718,
   "a": 27750,
   "tipus": "text",
   "ca": "El Barna hi posa l'altra meitat:",
   "id": "s078",
   "ar": "ويضع Barna النصف الآخر:"
  },
  {
   "de": 27759,
   "a": 27793,
   "tipus": "text",
   "ca": "seixanta-un anys d'ambient d'equip",
   "id": "s079",
   "ar": "واحدًا وستين عامًا من روح الفريق"
  },
  {
   "de": 27803,
   "a": 27913,
   "tipus": "text",
   "ca": "de club de barri,\n        grups per edat i nivell, i entrenadors que coneixen cada jugador i jugadora pel nom.",
   "id": "s080",
   "ar": "كنادي حي، ومجموعات بحسب العمر والمستوى، ومدرّبين يعرفون كل لاعب ولاعبة بالاسم."
  },
  {
   "de": 27976,
   "a": 28042,
   "tipus": "text",
   "ca": "Sessions dedicades a un sol aspecte del joc, no un totum revolutum",
   "id": "s081",
   "ar": "جلسات مخصصة لجانب واحد من اللعبة، لا خليط عشوائي"
  },
  {
   "de": 28058,
   "a": 28141,
   "tipus": "text",
   "ca": "Grups per edat i nivell: qui comença no entrena amb qui ja competeix des de fa anys",
   "id": "s082",
   "ar": "مجموعات بحسب العمر والمستوى: من يبدأ لا يتدرّب مع من ينافس منذ سنوات"
  },
  {
   "de": 28157,
   "a": 28227,
   "tipus": "text",
   "ca": "Places per a jugadors del Barna i per a jugadors de fora, cada setmana",
   "id": "s083",
   "ar": "مقاعد للاعبي Barna وللاعبين من خارجه، كل أسبوع"
  },
  {
   "de": 28358,
   "a": 28364,
   "tipus": "text",
