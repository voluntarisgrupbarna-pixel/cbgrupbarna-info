   "id": "s079",
   "tr": ""
  },
  {
   "de": 27170,
   "a": 27200,
   "tipus": "text",
   "ca": "El club treballa el campus amb",
   "id": "s080",
   "tr": ""
  },
  {
   "de": 27209,
   "a": 27221,
   "tipus": "text",
   "ca": "Time Chamber",
   "id": "s081",
   "tr": ""
  },
  {
   "de": 27230,
   "a": 27429,
   "tipus": "text",
   "ca": ", que aporta la metodologia de\n        treball individual: sessions curtes i repetitives sobre un sol aspecte del joc. El Barna hi posa\n        l'ambient d'equip de seixanta-un anys de club de barri.",
   "id": "s082",
   "tr": ""
  },
  {
   "de": 27445,
   "a": 27636,
   "tipus": "text",
   "ca": "Flow Camp, TC Basics, Shooting Academy, One &amp; One Mastery, Ballhandling Lab i Skills Lab\n        Experience. Obert a jugadors i jugadores de qualsevol club de Barcelona i de la província.",
   "id": "s083",
   "tr": ""
  },
  {
   "de": 27733,
   "a": 27771,
   "tipus": "text",
   "ca": "Veure el programa i els preus complets",
   "id": "s084",
   "tr": ""
