RewriteRule ^els\-equips\-sacosten\-a\-la\-casa\-de\-nadal\-de\-westfield\-glories/?$ https://cbgrupbarna.info/3x3/ [R=301,L]
RewriteRule ^exit\-del\-3x3\-de\-time\-chamber\-cb\-grup\-barna\-i\-westfield\-glories/?$ https://cbgrupbarna.info/3x3/ [R=301,L]
RewriteRule ^galeria\-fotografia\-del\-westfield\-glories\-cb\-grup\-barna\-vs\-tenerife\-nautico\-ull/?$ https://cbgrupbarna.info/3x3/ [R=301,L]
RewriteRule ^xocolatada\-solidaria\-a\-westfield\-glories/?$ https://cbgrupbarna.info/3x3/ [R=301,L]

# ── La secció femenina · 1 notícies ──
RewriteRule ^8\-m\-dia\-internacional\-de\-la\-dona/?$ https://cbgrupbarna.info/femeni/ [R=301,L]

# ── La resta ────────────────────────────────────────────────────────────
# Categories, etiquetes, arxius per mes i el canal RSS: totes són llistats
# de notícies, i el seu equivalent a la web nova és la sala de premsa.
RewriteRule ^(category|tag|author|20[0-9]{2})/ https://cbgrupbarna.info/premsa/ [R=301,L]
RewriteRule ^feed/?$                          https://cbgrupbarna.info/premsa/ [R=301,L]

# I la portada.
RewriteRule ^$ https://cbgrupbarna.info/ [R=301,L]

# Res més. El que no encaixi amb cap regla ha de seguir donant 404, que és
# la resposta honesta: un 301 massiu cap a la portada per a URLs que mai
# van existir és justament el que Google degrada a soft-404.
