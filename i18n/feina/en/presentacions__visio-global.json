  {
   "de": 16822,
   "a": 17016,
   "tipus": "text",
   "ca": "Cinc peces, una sola lectura: qui som, la proposta de bàsquet femení a la FCBQ,\n    el campus amb Time Chamber, la recerca amb dades i el dossier de patrocinis. El club sencer, d'una\n    tirada.",
   "id": "s030",
   "en": ""
  },
  {
   "de": 17138,
   "a": 17145,
   "tipus": "text",
   "ca": "Qui som",
   "id": "s031",
   "en": ""
  },
  {
   "de": 17154,
   "a": 17182,
   "tipus": "text",
   "ca": "61 anys · Poblenou i el Clot",
   "id": "s032",
   "en": ""
  },
  {
