# Supabase (mateix projecte que /galeria o un de nou, tots dos gratuïts)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Clau secreta — NOMÉS servidor, mai al navegador. Necessària per pujar
# fotos i llegir el carnet des de les pàgines públiques (/carnet i /verificar).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# URL pública on es desplega aquesta app (per generar els enllaços del QR
# i del carnet). En producció: https://carnet.cbgrupbarna.info
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Google Wallet (gratuït) — es crea a https://pay.google.com/business/console
# Issuer ID del compte de Google Wallet Business Console
GOOGLE_WALLET_ISSUER_ID=1234567890123456789
# Service account amb rol "Wallet Object Issuer" (Google Cloud Console)
GOOGLE_WALLET_CLIENT_EMAIL=carnet-cbgb@your-project.iam.gserviceaccount.com
# Clau privada del JSON del service account (amb els \n literals, entre cometes)
GOOGLE_WALLET_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
