{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/intensive/index.html" }
  ],
  "redirects": [
    { "source": "/reservar", "destination": "/intensive/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
