  },
  {
   "de": 25074,
   "a": 25090,
   "tipus": "text",
   "ca": "Ballhandling Lab",
   "id": "s065",
   "ja": "Ballhandling Lab"
  },
  {
   "de": 25098,
   "a": 25132,
